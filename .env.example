ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview_guide
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File storage
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# Redis
REDIS_URL=redis://localhost:6379/0
# Optional local MinIO/S3 backend:
# STORAGE_BACKEND=s3
# S3_BUCKET=interview-guide
# S3_ENDPOINT_URL=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=local-minio
# S3_SECRET_ACCESS_KEY=local-minio-password

# Chat provider. Set ACTIVE_CHAT_PROVIDER to one of the keys in MODEL_PROVIDERS.
# Default: Alibaba Cloud Bailian (Model Studio) through its OpenAI-compatible
# endpoint, so the existing OpenAI SDK path is reused unchanged.

# ACTIVE_CHAT_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
ACTIVE_CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# Provider entries point to OpenAI-compatible Chat Completions APIs.
# Configure the API key named in api_key_env in this .env file.
# Model authorization is per workspace: only use models listed as 已授权 in the
# Bailian console (for example qwen3.8-flash, qwen3.7-plus, qwen3.7-max),
# otherwise calls fail with 403 AccessDenied.Unpurchased. The key must also
# belong to the same workspace as the api-host; a key issued for another space
# returns 403 for every model, including "已授权" ones.
MODEL_PROVIDERS={"dashscope":{"base_url":"https://ws-rudsewptgk038m2y.cn-beijing.maas.aliyuncs.com/compatible-mode/v1","model":"qwen3.8-flash","api_key_env":"DASHSCOPE_API_KEY"},"deepseek":{"base_url":"https://api.deepseek.com","model":"deepseek-chat","api_key_env":"DEEPSEEK_API_KEY"},"openai":{"base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","api_key_env":"OPENAI_API_KEY"}}
# Keys registered through MODEL_PROVIDERS are read with os.getenv, so when you
# run Uvicorn directly (not through Compose) export them in the shell too:
#   export DASHSCOPE_API_KEY=sk-...
# OPENAI_API_KEY=
# MOONSHOT_API_KEY=
# GLM_API_KEY=
# LM_STUDIO_API_KEY=lm-studio

# Embedding is configured independently from chat, and is only usable if your
# workspace has authorized an embedding model. If every embedding model returns
# 403 AccessDenied.Unpurchased, point these three settings at another
# OpenAI-compatible embedding service instead of enabling one in Bailian.
# Keep EMBEDDING_PROVIDER=custom-openai-compatible unless you need to switch
# between several registered providers: this mode reads EMBEDDING_API_KEY
# through the settings object, so it works both in Docker and when running
# Uvicorn directly, while the registry mode reads the key with os.getenv.
EMBEDDING_PROVIDER=custom-openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ws-rudsewptgk038m2y.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# DashScope accepts smaller batches than OpenAI. Lower this if ingestion
# returns a batch size error.
EMBEDDING_BATCH_SIZE=10
# Dimensions must match the database vector column, which is fixed when
# migration 0003 runs. Switching models or dimensions requires recreating the
# column and re-ingesting documents (see README "Storage backends" notes).
# To register/select several embedding providers, use:
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_PROVIDERS={"dashscope":{"base_url":"https://ws-rudsewptgk038m2y.cn-beijing.maas.aliyuncs.com/compatible-mode/v1","model":"text-embedding-v3","api_key_env":"EMBEDDING_API_KEY"},"openai":{"base_url":"https://api.openai.com/v1","model":"text-embedding-3-small","api_key_env":"OPENAI_EMBEDDING_API_KEY"}}
# OPENAI_EMBEDDING_API_KEY=

# Alibaba Cloud Bailian / DashScope realtime speech. AI_BAILIAN_API_KEY is the
# same DashScope API key as EMBEDDING_API_KEY above; one key serves chat,
# embeddings and realtime speech.
AI_BAILIAN_API_KEY=
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Cherry
# Realtime speech uses the DashScope SDK, not the OpenAI-compatible endpoint,
# and defaults to wss://dashscope.aliyuncs.com/api-ws/v1/realtime. Uncomment and
# adjust only if your workspace gateway exposes the realtime WebSocket, for
# example wss://<api-host>/api-ws/v1/realtime.
# QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
