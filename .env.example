ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview_guide
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

STORAGE_BACKEND=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

REDIS_URL=redis://localhost:6379/0
# Optional local MinIO/S3 backend:
# STORAGE_BACKEND=s3
# S3_BUCKET=interview-guide
# S3_ENDPOINT_URL=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=local-minio
# S3_SECRET_ACCESS_KEY=local-minio-password

# Chat provider. Set ACTIVE_CHAT_PROVIDER to one of the keys in MODEL_PROVIDERS.
ACTIVE_CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# Provider entries point to OpenAI-compatible Chat Completions APIs.
# Configure the API key named in api_key_env in this .env file.
# MODEL_PROVIDERS={"openai":{"base_url":"https://api.openai.com/v1","model":"gpt-4o-mini","api_key_env":"OPENAI_API_KEY"},"dashscope":{"base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen3.5-flash","api_key_env":"DASHSCOPE_API_KEY"},"kimi":{"base_url":"https://api.moonshot.cn/v1","model":"moonshot-v1-8k","api_key_env":"MOONSHOT_API_KEY"},"deepseek":{"base_url":"https://api.deepseek.com","model":"deepseek-chat","api_key_env":"DEEPSEEK_API_KEY"},"glm":{"base_url":"https://open.bigmodel.cn/api/paas/v4","model":"glm-4-flash","api_key_env":"GLM_API_KEY"},"lm-studio":{"base_url":"http://host.docker.internal:1234/v1","model":"your-local-model","api_key_env":"LM_STUDIO_API_KEY"}}
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# GLM_API_KEY=
# LM_STUDIO_API_KEY=lm-studio

# Embedding is configured independently. Its dimensions must match the
# database vector column; changing dimensions requires recreating/migrating it.
EMBEDDING_PROVIDER=custom-openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# To register/select several embedding providers, use:
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_PROVIDERS={"dashscope":{"base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"text-embedding-v3","api_key_env":"EMBEDDING_API_KEY"},"openai":{"base_url":"https://api.openai.com/v1","model":"text-embedding-3-small","api_key_env":"OPENAI_EMBEDDING_API_KEY"}}
# EMBEDDING_DIMENSIONS=1024
# OPENAI_EMBEDDING_API_KEY=

# Alibaba Cloud Bailian / DashScope realtime speech key and models.
AI_BAILIAN_API_KEY=
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_TTS_MODEL=qwen3-tts-flash-realtime
QWEN_TTS_VOICE=Cherry

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
